#!/bin/bash

set -eu

# cd to location of script
cd "$(dirname "$(realpath "$0")")"

config=docker-compose.jsonnet
if [[ -f docker-compose.local.jsonnet ]]; then
	config=docker-compose.local.jsonnet
fi

# We generate first, and capture the output, to avoid overwriting the file on error.
# To avoid jsonnet needing to exist locally, we run it in a container.
output=$(docker run --rm -i -v "$PWD:/config:ro" -w /config sparkprime/jsonnet -V tag="$(./get-build-tag)" "$config")

{
	echo "# DO NOT EDIT THIS FILE!"
	echo "# This file is generated from $config"
	echo "# It can be generated by running ./generate-docker-compose"
	echo "$output"
} > docker-compose.yml

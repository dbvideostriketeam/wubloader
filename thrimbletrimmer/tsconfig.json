{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"types": ["vidstack/solid", "vite/client", "google.accounts"],
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"strict": true
	},
	"exclude": ["vite.config.ts"]
}
